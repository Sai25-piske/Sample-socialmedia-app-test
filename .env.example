# Flask Configuration
FLASK_SECRET_KEY=your_flask_secret_key_here

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=piskegram
MYSQL_USER=piskegram_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Optional AWS S3 configuration. Leave S3_BUCKET empty to use local Docker storage.
S3_BUCKET=
S3_PREFIX=uploads
AWS_REGION=ap-south-1
